<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav"
    app:startDestination="@id/inboxFragment">
    <fragment android:id="@+id/inboxFragment"
        android:name="vn.edu.lwd7071.androidfinalproject.ui.PlaceholderFragment"
        android:label="@string/nav_inbox" />
    <fragment android:id="@+id/contactsFragment"
        android:name="vn.edu.lwd7071.androidfinalproject.ui.PlaceholderFragment"
        android:label="@string/nav_contacts">
        <action android:id="@+id/action_contacts_to_user_profile"
            app:destination="@id/userProfileFragment" />
        <action android:id="@+id/action_contacts_to_add_contact"
            app:destination="@id/addContactFragment" />
    </fragment>
    <fragment android:id="@+id/profileFragment"
        android:name="vn.edu.lwd7071.androidfinalproject.ui.PlaceholderFragment"
        android:label="@string/nav_profile" />
    <fragment android:id="@+id/addContactFragment"
        android:name="vn.edu.lwd7071.androidfinalproject.ui.PlaceholderFragment"
        android:label="@string/add_contact_title" />
    <fragment android:id="@+id/userProfileFragment"
        android:name="vn.edu.lwd7071.androidfinalproject.ui.PlaceholderFragment"
        android:label="@string/user_profile_title">
        <argument android:name="userId" app:argType="string" />
        <action android:id="@+id/action_user_profile_to_chat"
            app:destination="@id/chatPlaceholderFragment" />
    </fragment>
    <fragment android:id="@+id/chatPlaceholderFragment"
        android:name="vn.edu.lwd7071.androidfinalproject.ui.PlaceholderFragment"
        android:label="@string/chat_title" />
</navigation>
